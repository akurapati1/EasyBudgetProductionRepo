# Required
MONGODB_URI=mongodb://localhost:27017/easybudget
JWT_SECRET=replace-with-a-long-random-string

# Optional
PORT=5001
CLIENT_ORIGIN=http://localhost:3000        # comma-separate multiple origins
AUTH_RATE_LIMIT=100                        # requests per 15 min per IP on /auth/*

# Password-reset e-mail (Gmail needs an App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
